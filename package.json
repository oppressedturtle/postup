{
  "name": "postup",
  "version": "0.1.0",
  "private": true,
  "description": "PostUp — a modern community platform (Hubs, Drops, voting, threaded replies, rich media, moderation).",
  "license": "MIT",
  "author": "Yanis (oppressedturtle)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "next": "14.2.5",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "20.14.10",
    "@types/pg": "^8.20.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "eslint-config-prettier": "9.1.0",
    "postcss": "8.4.39",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.5",
    "tailwindcss": "3.4.6",
    "ts-node": "^10.9.2",
    "typescript": "5.5.3",
    "vitest": "2.0.3"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "esbuild@0.21.5": true,
    "prisma@7.8.0": true,
    "unrs-resolver@1.12.2": true
  }
}
