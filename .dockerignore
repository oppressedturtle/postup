# Source control
.git
.gitignore

# Node / Next.js build artefacts
node_modules
.next

# Secrets — never bake into the image
.env
.env.local
.env.*.local

# Test & coverage output
coverage
*.lcov

# Logs
*.log
npm-debug.log*

# OS artefacts
.DS_Store
Thumbs.db

# Editor
.vscode
.idea

# TypeScript incremental build cache
*.tsbuildinfo

# prisma/migrations is intentionally NOT excluded so migrations can run
# inside the container if needed.
