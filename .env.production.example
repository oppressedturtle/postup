# PostUp — production environment variables
# Copy to .env.production and fill in all values before deploying.
# NEVER commit .env.production to version control.
#
# Generate secrets with:
#   openssl rand -base64 32

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Auth.js / NextAuth ────────────────────────────────────────────────────────
NEXTAUTH_URL=https://your-domain.com
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=<generate with: openssl rand -base64 32>

# ── Database ──────────────────────────────────────────────────────────────────
# Use a managed Postgres service (Railway / Supabase / Neon / RDS).
# Always use sslmode=require in production.
DATABASE_URL=postgresql://user:password@host:5432/postup_prod?sslmode=require

# Credentials used by the postgres service in docker-compose.prod.yml.
# Must match the user/password in DATABASE_URL when running self-hosted Postgres.
POSTGRES_USER=postup
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=postup

# ── Redis ─────────────────────────────────────────────────────────────────────
# Include the password in the URL when using requirepass (docker-compose.prod.yml does this).
REDIS_URL=redis://:your-redis-password@redis:6379
# Separate password var used by docker-compose.prod.yml --requirepass flag.
REDIS_PASSWORD=<strong-random-password>

# ── S3-compatible object storage ──────────────────────────────────────────────
# For AWS S3 — set endpoint to https://s3.amazonaws.com (or omit for SDK default).
# For Cloudflare R2 — https://<account-id>.r2.cloudflarestorage.com
# For Backblaze B2 — https://s3.<region>.backblazeb2.com
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=postup-production

# ── OAuth providers ───────────────────────────────────────────────────────────
# Register production OAuth apps:
#   GitHub: https://github.com/settings/developers → OAuth Apps → New OAuth App
#     Callback URL: https://your-domain.com/api/auth/callback/github
#   Google: https://console.cloud.google.com → APIs & Services → Credentials
#     Authorized redirect URI: https://your-domain.com/api/auth/callback/google
#
# Leave empty to disable the provider (credential login still works).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
