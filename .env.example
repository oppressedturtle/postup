# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/postup_dev"

# Auth.js / NextAuth
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Redis (BullMQ / caching)
REDIS_URL="redis://localhost:6379"

# S3-compatible object storage (MinIO in local dev, real S3 in production)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
S3_BUCKET="postup"

# OAuth providers (optional — app works without these configured)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
